# Cloudflare Pages cache rules — Astro fingerprints bundles in /_astro/ so they
# are safe to cache forever; HTML must always be re-validated.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cache-Control: public, max-age=604800

/images/*
  Cache-Control: public, max-age=604800

/videos/*
  Cache-Control: public, max-age=604800

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
