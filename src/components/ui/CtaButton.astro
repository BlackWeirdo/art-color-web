---
import Icon from './Icon.astro';

/**
 * Primary call-to-action button used in hero, CTAs, and section banners.
 *
 * Usage:
 *   <CtaButton href="#contact">Tư vấn ngay</CtaButton>
 *   <CtaButton href="#products" variant="primary" arrow={false}>Khám phá</CtaButton>
 *   <CtaButton href="#contact" variant="outline">Liên hệ tư vấn</CtaButton>
 */
interface Props {
  href: string;
  /** Visual style. Primary = solid yellow filled. Outline = bordered transparent. */
  variant?: 'primary' | 'outline';
  /** Render trailing arrow-right icon (default true). */
  arrow?: boolean;
  /** Additional Tailwind classes appended to the base styles. */
  class?: string;
}
const { href, variant = 'primary', arrow = true, class: extraClass = '' } = Astro.props;

const BASE_CLASS =
  'btn-press inline-flex items-center gap-2 px-6 md:px-7 py-3.5 rounded-lg font-semibold transition-all';
const VARIANT_CLASS = {
  primary: 'bg-[--color-accent] text-[--color-accent-fg] hover:opacity-90 hover:gap-3',
  outline: 'border-2 border-[--color-border] hover:border-[--color-accent] hover:text-[--color-accent]',
};
---

<a href={href} class:list={[BASE_CLASS, VARIANT_CLASS[variant], extraClass]}>
  <slot />
  {arrow && <Icon name="arrow-right" size={16} />}
</a>
