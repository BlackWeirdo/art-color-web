---
/**
 * Centered section heading used across most landing sections.
 *
 * Usage:
 *   <SectionHeading label="Tính năng nổi bật" title="Mọi thứ bạn cần cho buổi tập">
 *     Optional descriptive paragraph as default slot.
 *   </SectionHeading>
 */
interface Props {
  /** Small uppercase eyebrow (rendered above the title in accent color). */
  label?: string;
  /** Main h2 heading text. */
  title: string;
}
const { label, title } = Astro.props;
const hasDesc = Astro.slots.has('default');
---

<div class="max-w-2xl mx-auto text-center mb-12 md:mb-16">
  {label && (
    <p class="text-sm uppercase tracking-wider text-[--color-accent]">{label}</p>
  )}
  <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-bold">{title}</h2>
  {hasDesc && (
    <p class="mt-4 text-[--color-muted]"><slot /></p>
  )}
</div>
