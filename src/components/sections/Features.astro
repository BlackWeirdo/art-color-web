---
import type { Product } from "../../data/product.ts";
import { pad2 } from "../../utils/format.ts";

interface Props {
  product: Product;
}
const { product } = Astro.props;

// Product-feature line-art icons (28×28, currentColor stroke). Kept inline
// because they map 1:1 to ProductFeature.icon enum and aren't reused elsewhere.
const FEATURE_ICONS: Record<string, string> = {
  spark:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>',
  route:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="19" r="3"/><circle cx="18" cy="5" r="3"/><path d="M9 19h6a4 4 0 0 0 0-8H9a4 4 0 0 1 0-8h6"/></svg>',
  music:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>',
  pulse:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>',
  shield:
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
};

const total = product.features.length;
---

<section id="features" data-reveal class="px-4 md:px-8 pt-16 md:pt-24 pb-4 max-w-7xl mx-auto">
  <div class="max-w-2xl mx-auto text-center mb-4 md:mb-8">
    <p class="text-sm uppercase tracking-wider text-[--color-accent]">Tính năng nổi bật</p>
    <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-bold">
      Mọi thứ bạn cần cho buổi tập
    </h2>
    <p class="mt-4 text-[--color-muted]">
      Cuộn xuống để khám phá từng tính năng — mỗi mục là một câu chuyện riêng.
    </p>
  </div>
</section>

<div class="px-4 md:px-8">
  {product.features.map((feature, i) => {
    const isImageRight = i % 2 === 1; // index 0,2,4 → image left; 1,3 → image right
    return (
      <article
        data-feature-row
        data-feature-index={i}
        class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-14 lg:gap-20 items-center py-12 md:py-24 lg:py-32 max-w-6xl mx-auto"
      >
        <div
          data-feature-image
          class:list={["order-1", isImageRight ? "md:order-2" : "md:order-1"]}
        >
          <div
            data-img-loading="true"
            class="relative overflow-hidden rounded-3xl bg-[--color-card] ring-1 ring-[--color-border] aspect-[4/3]"
            style="box-shadow: var(--shadow-xl);"
          >
            <img
              src={feature.image}
              alt={feature.title}
              loading="lazy"
              decoding="async"
              onload="this.parentElement.dataset.imgLoading='false'"
              onerror="this.parentElement.dataset.imgLoading='false'"
              class="relative z-[2] w-full h-full object-cover transition-transform duration-700 hover:scale-[1.03]"
            />
            <span class="absolute z-[3] top-4 left-4 px-3 py-1.5 rounded-full bg-[--color-accent] text-[--color-accent-fg] text-xs font-bold uppercase tracking-wider">
              {pad2(i + 1)} / {pad2(total)}
            </span>
          </div>
        </div>

        <div
          data-feature-content
          class:list={["order-2", isImageRight ? "md:order-1" : "md:order-2"]}
        >
          <div class="flex items-baseline gap-4">
            <span class="feature-numeral text-7xl md:text-8xl font-black">{pad2(i + 1)}</span>
            <span class="text-[--color-accent]" aria-hidden="true">
              <Fragment set:html={FEATURE_ICONS[feature.icon]} />
            </span>
          </div>

          <h3 class="mt-2 md:mt-3 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight">
            {feature.title}
          </h3>

          <p class="mt-5 md:mt-6 text-base md:text-lg text-[--color-muted] leading-relaxed max-w-prose">
            {feature.body}
          </p>

          <div class="mt-6 md:mt-8 flex items-center gap-3 text-xs uppercase tracking-wider text-[--color-muted]">
            <span class="h-px w-10 bg-[--color-accent]"></span>
            <span>Tính năng {pad2(i + 1)} / {pad2(total)}</span>
          </div>
        </div>
      </article>
    );
  })}
</div>
