---
import { contact } from "../../data/contact.ts";

const mailto = `mailto:${contact.email}?subject=${encodeURIComponent(contact.subjectPrefill)}`;
const tel = `tel:${contact.phone.replace(/\s/g, '')}`;
---

<section id="contact" data-reveal class="px-4 md:px-8 py-16 md:py-24 max-w-3xl mx-auto">
  <div class="text-center mb-10">
    <p class="text-sm uppercase tracking-wider text-[--color-accent]">Liên hệ</p>
    <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-bold">Cần tư vấn thêm?</h2>
    <p class="mt-4 text-[--color-muted]">
      Chuyên gia sẽ phản hồi sớm nhất qua kênh bạn chọn.
    </p>
  </div>

  <div class="grid sm:grid-cols-3 gap-3 md:gap-4">
    <a
      href={mailto}
      aria-label={`Gửi email tới ${contact.email}`}
      class="btn-press card-lift group flex flex-col items-center text-center p-6 rounded-2xl bg-[--color-card] border border-[--color-border] hover:border-[--color-accent]"
    >
      <span class="w-11 h-11 grid place-items-center rounded-full bg-[--color-accent]/15 text-[--color-accent]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
          <polyline points="22,6 12,13 2,6"/>
        </svg>
      </span>
      <span class="mt-3 text-xs uppercase tracking-wider text-[--color-muted]">Email</span>
      <span class="mt-1 font-semibold break-all">{contact.email}</span>
    </a>

    <a
      href={tel}
      aria-label={`Gọi ${contact.phone}`}
      class="btn-press card-lift group flex flex-col items-center text-center p-6 rounded-2xl bg-[--color-card] border border-[--color-border] hover:border-[--color-accent]"
    >
      <span class="w-11 h-11 grid place-items-center rounded-full bg-[--color-accent]/15 text-[--color-accent]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/>
        </svg>
      </span>
      <span class="mt-3 text-xs uppercase tracking-wider text-[--color-muted]">Hotline</span>
      <span class="mt-1 font-semibold">{contact.phone}</span>
    </a>

    <a
      href={contact.zaloUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Chat qua Zalo"
      class="btn-press card-lift group flex flex-col items-center text-center p-6 rounded-2xl bg-[--color-card] border border-[--color-border] hover:border-[--color-accent]"
    >
      <span class="w-11 h-11 grid place-items-center rounded-full bg-[--color-accent]/15 text-[--color-accent]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
      </span>
      <span class="mt-3 text-xs uppercase tracking-wider text-[--color-muted]">Zalo</span>
      <span class="mt-1 font-semibold">Chat ngay</span>
    </a>
  </div>

  <div class="mt-10 flex flex-col items-center gap-4">
    <p class="text-sm text-[--color-muted]">Hoặc theo dõi qua mạng xã hội</p>
    <div class="flex gap-3">
      {contact.socials.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.name}
          class="icon-hover w-11 h-11 grid place-items-center rounded-full border border-[--color-border] hover:border-[--color-accent] hover:text-[--color-accent]"
        >
          <Fragment set:html={s.icon} />
        </a>
      ))}
    </div>
  </div>
</section>
