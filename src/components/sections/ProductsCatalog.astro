---
import { products } from "../../data/product.ts";
---

<section id="products" data-reveal class="px-4 md:px-8 py-16 md:py-24 max-w-7xl mx-auto">
  <div class="max-w-2xl mx-auto text-center mb-12 md:mb-16">
    <p class="text-sm uppercase tracking-wider text-[--color-accent]">Sản phẩm</p>
    <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-bold">
      Bộ sưu tập đầy đủ
    </h2>
    <p class="mt-4 text-[--color-muted]">
      Tìm thiết bị phù hợp cho không gian tập luyện của bạn — từ chạy bộ, đạp xe đến rowing và tạ đa năng.
    </p>
  </div>

  <div data-stagger-parent class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
    {products.map((p) => (
      <a
        data-stagger-item
        href={`/san-pham/${p.slug}/`}
        class="card-lift group flex flex-col rounded-2xl bg-[--color-card] border border-[--color-border] hover:border-[--color-accent] overflow-hidden"
      >
        <div class="aspect-[4/3] overflow-hidden bg-[--color-bg]">
          <img
            src={p.images[0]}
            alt={p.name}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-500"
          />
        </div>

        <div class="flex-1 flex flex-col p-5 md:p-6">
          <p class="text-[10px] uppercase tracking-[0.15em] text-[--color-muted] font-mono">{p.sku}</p>
          <h3 class="mt-2 text-lg md:text-xl font-bold leading-tight group-hover:text-[--color-accent] transition-colors">
            {p.name}
          </h3>
          <p class="mt-2 text-sm text-[--color-muted] leading-relaxed line-clamp-2 flex-1">
            {p.tagline}
          </p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-[--color-accent] group-hover:gap-2.5 transition-all">
            Xem chi tiết
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>
