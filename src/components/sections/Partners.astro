---
import { partners } from "../../data/partners.ts";
import SectionHeading from "../ui/SectionHeading.astro";
import LogoImage from "../ui/LogoImage.astro";
---

<section id="partners" data-reveal class="py-16 md:py-24">
  <div class="px-4 md:px-8 max-w-7xl mx-auto">
    <SectionHeading label="Đối tác · Khách hàng" title="Khách hàng của chúng tôi">
      Được tin chọn bởi những thương hiệu, đại sứ và đối tác hàng đầu trong và ngoài nước.
    </SectionHeading>

    <div class="md:divide-y md:divide-[--color-border]">
      {partners.map((cat) => {
        const isTextOnly = !cat.items.some((i) => i.logo);
        const lines = cat.label.split('\n');
        return (
          <div
            data-stagger-parent
            class="grid grid-cols-1 md:grid-cols-[minmax(200px,_1fr)_4fr] gap-6 md:gap-12 lg:gap-16 items-center py-10 md:py-14 lg:py-16 border-t border-[--color-border] md:border-0 first:border-0"
          >
            <h3 class="partner-category text-xl md:text-2xl lg:text-[28px] font-black uppercase text-center md:text-left">
              {lines.map((line, i) => (
                <Fragment>
                  {i > 0 && <br />}
                  <span class="line">{line}</span>
                </Fragment>
              ))}
            </h3>

            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-4 gap-y-8 md:gap-x-6 md:gap-y-10 items-center">
              {cat.items.map((item) => (
                <div
                  data-stagger-item
                  class="partner-item flex items-center justify-center min-h-[64px] md:min-h-[88px] px-2"
                >
                  {item.logo ? (
                    <LogoImage
                      src={item.logo}
                      alt={item.name}
                      imgClass="partner-logo max-h-10 md:max-h-12 lg:max-h-14 w-auto opacity-90 hover:opacity-100 transition-opacity"
                    />
                  ) : isTextOnly ? (
                    <p class="text-center font-semibold text-sm md:text-base lg:text-lg leading-snug whitespace-pre-line">
                      {item.name}
                    </p>
                  ) : (
                    <p class="text-center text-xs md:text-sm font-medium italic text-[--color-muted] leading-tight">
                      {item.name}
                    </p>
                  )}
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
