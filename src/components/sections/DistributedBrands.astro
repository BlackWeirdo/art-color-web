---
import { distributedBrands } from "../../data/distributed-brands.ts";
import { BRAND } from "../../data/site.ts";
import CtaButton from "../ui/CtaButton.astro";
import LogoImage from "../ui/LogoImage.astro";
---

<section id="brands" data-reveal class="px-4 md:px-8 py-16 md:py-24 max-w-7xl mx-auto">
  <!-- 2-col header: headline left, subhead right -->
  <div class="grid md:grid-cols-2 gap-6 md:gap-12 lg:gap-16 items-start mb-14 md:mb-20">
    <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold uppercase tracking-tight leading-[1.2]">
      Thương hiệu hàng đầu thế giới,<br />
      <span class="text-[--color-accent]">độc quyền tại Việt Nam.</span>
    </h2>

    <p class="md:pt-3 text-base md:text-lg text-[--color-muted] leading-relaxed">
      {BRAND} là nhà phân phối chính thức và độc quyền của các thương hiệu fitness và wellness uy tín trên thế giới.
    </p>
  </div>

  <!-- Brand logos row -->
  <div
    data-stagger-parent
    class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-6 gap-y-10 md:gap-x-10 md:gap-y-12 items-center justify-items-center mb-14 md:mb-16 py-6"
  >
    {distributedBrands.map((b) => (
      <div
        data-stagger-item
        class="distributed-brand flex items-center justify-center min-h-[60px] md:min-h-[80px] w-full px-2"
      >
        {b.logo ? (
          <LogoImage src={b.logo} alt={b.name} />
        ) : (
          <p class="text-center text-xs md:text-sm font-medium italic text-[--color-muted] leading-tight">
            {b.name}
          </p>
        )}
      </div>
    ))}
  </div>

  <!-- CTA banner bottom-right -->
  <div class="flex justify-center md:justify-end">
    <div class="flex flex-col sm:flex-row items-stretch rounded-xl overflow-hidden border border-[--color-border] max-w-2xl w-full shadow-lg">
      <p class="flex-1 px-5 py-4 bg-[--color-card] text-sm md:text-base text-[--color-fg] flex items-center">
        Tư vấn doanh nghiệp — Báo giá ưu đãi cho dự án quy mô lớn
      </p>
      <CtaButton href="#contact" class="rounded-none">Liên hệ ngay</CtaButton>
    </div>
  </div>
</section>
