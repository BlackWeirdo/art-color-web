---
import { services } from "../../data/services.ts";
import { pad2 } from "../../utils/format.ts";
---

<section id="services" data-reveal class="px-4 md:px-8 py-16 md:py-24 max-w-7xl mx-auto">
  <div class="grid md:grid-cols-2 gap-6 md:gap-12 mb-14 md:mb-20">
    <div>
      <p class="text-sm uppercase tracking-[0.2em] text-[--color-accent] font-semibold">Dịch vụ</p>
      <h2 class="font-serif mt-3 text-3xl md:text-4xl lg:text-5xl font-semibold tracking-tight leading-[1.15]">
        Đồng hành liền mạch<br />
        từ <em class="italic font-normal text-[--color-accent]">tầm nhìn đến hiện thực.</em>
      </h2>
    </div>
  </div>

  <div data-stagger-parent class="relative grid grid-cols-1 md:grid-cols-4 gap-y-10 md:gap-y-0 gap-x-6 md:gap-x-8">
    <!-- Horizontal connecting line (desktop only, behind circles) -->
    <div class="hidden md:block absolute top-12 left-[12.5%] right-[12.5%] h-px bg-[--color-border]" aria-hidden="true"></div>

    {services.map((s, i) => (
      <div data-stagger-item class="relative flex flex-col items-center md:items-start text-center md:text-left">
        <div class="relative z-10 w-24 h-24 rounded-full border-2 border-[--color-fg] grid place-items-center bg-[--color-bg]">
          <span class="font-serif text-2xl md:text-3xl font-medium tracking-tight" aria-label={`Bước ${i + 1}`}>
            {pad2(i + 1)}
          </span>
        </div>

        <h3 class="font-serif mt-6 md:mt-8 text-xl md:text-2xl font-semibold leading-[1.15] whitespace-pre-line">
          {s.title}
        </h3>

        <p class="mt-3 md:mt-4 text-sm md:text-[15px] text-[--color-muted] leading-relaxed">
          {s.desc}
        </p>
      </div>
    ))}
  </div>
</section>
