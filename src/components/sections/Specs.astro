---
import type { Product } from "../../data/product.ts";
import SectionHeading from "../ui/SectionHeading.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<section id="specs" data-reveal class="px-4 md:px-8 py-16 md:py-24 max-w-5xl mx-auto">
  <SectionHeading label="Thông số kỹ thuật" title="Thông tin chi tiết">
    Giá trị bên dưới là placeholder. Thay bằng thông số thật của sản phẩm trong
    <code class="text-xs px-1.5 py-0.5 rounded bg-[--color-card]">src/data/product.ts</code>.
  </SectionHeading>

  <!-- Desktop: table -->
  <table class="hidden md:table w-full border-separate border-spacing-0 rounded-xl overflow-hidden border border-[--color-border]">
    <thead>
      <tr>
        <th class="text-left px-5 py-3 bg-[--color-card] font-semibold text-sm uppercase tracking-wider text-[--color-muted] border-b border-[--color-border]">
          Thông số
        </th>
        <th class="text-left px-5 py-3 bg-[--color-card] font-semibold text-sm uppercase tracking-wider text-[--color-muted] border-b border-[--color-border]">
          Giá trị
        </th>
      </tr>
    </thead>
    <tbody data-stagger-parent>
      {product.specs.map((spec, i) => (
        <tr data-stagger-item class:list={[i % 2 === 1 && "bg-[--color-card]/40"]}>
          <td class="px-5 py-4 font-medium border-t border-[--color-border]">{spec.label}</td>
          <td class="px-5 py-4 text-[--color-muted] border-t border-[--color-border]">{spec.value}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <!-- Mobile: native <details> accordion (no JS) -->
  <div data-stagger-parent class="md:hidden space-y-2">
    {product.specs.map((spec, i) => (
      <details
        data-stagger-item
        open={i === 0}
        class="group rounded-xl bg-[--color-card] border border-[--color-border] overflow-hidden"
      >
        <summary class="flex items-center justify-between gap-3 px-4 py-4 cursor-pointer select-none font-semibold">
          <span>{spec.label}</span>
          <Icon name="chevron-down" size={20} class="text-[--color-muted] transition-transform duration-200 group-open:rotate-180" />
        </summary>
        <p class="px-4 pb-4 text-[--color-muted]">{spec.value}</p>
      </details>
    ))}
  </div>
</section>
