---
import { products } from "../../data/product.ts";

const brand = products[0]?.brand ?? 'Art Color';
const featured = products.slice(0, 4);
---

<section
  id="hero"
  data-hero
  class="px-4 md:px-8 pt-10 md:pt-20 pb-16 md:pb-24 max-w-7xl mx-auto"
>
  <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
    <div>
      <p data-hero-meta class="inline-flex items-center gap-2 text-xs md:text-sm uppercase tracking-[0.2em] text-[--color-accent] font-semibold">
        <span class="inline-block w-8 h-px bg-[--color-accent]"></span>
        Phân phối Technogym chính hãng
      </p>

      <h1 data-hero-title class="mt-5 text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-black tracking-tight leading-[1.05]">
        Sống khỏe<br />
        từng ngày<br />
        cùng <span class="text-[--color-accent]">{brand}</span>
      </h1>

      <p data-hero-tagline class="mt-6 text-lg md:text-xl text-[--color-muted] leading-relaxed max-w-prose">
        Thiết bị fitness cao cấp dành cho gia đình, phòng tập chuyên nghiệp và doanh nghiệp.
        Tư vấn lắp đặt, vận hành và bảo hành tận tâm.
      </p>

      <div data-hero-price class="mt-8 md:mt-10 flex flex-wrap gap-3">
        <a
          href="#products"
          class="btn-press inline-flex items-center gap-2 px-6 md:px-7 py-3.5 rounded-lg bg-[--color-accent] text-[--color-accent-fg] font-semibold hover:opacity-90 hover:gap-3 transition-all"
        >
          Khám phá sản phẩm
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a
          href="#contact"
          class="btn-press inline-flex items-center gap-2 px-6 md:px-7 py-3.5 rounded-lg border-2 border-[--color-border] hover:border-[--color-accent] hover:text-[--color-accent] font-semibold transition-colors"
        >
          Liên hệ tư vấn
        </a>
      </div>
    </div>

    <div data-hero-gallery class="hidden md:block">
      <div class="grid grid-cols-2 gap-3 md:gap-4">
        {featured.map((p, i) => (
          <a
            href={`/san-pham/${p.slug}/`}
            class:list={[
              "group relative aspect-square rounded-2xl overflow-hidden ring-1 ring-[--color-border] hover:ring-[--color-accent] transition-all shadow-lg",
              i === 1 && "translate-y-6 md:translate-y-10",
              i === 2 && "-translate-y-6 md:-translate-y-10",
            ]}
          >
            <img
              src={p.images[0]}
              alt={p.name}
              loading="eager"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-x-0 bottom-0 p-3 bg-gradient-to-t from-black/80 via-black/30 to-transparent">
              <p class="text-xs font-semibold text-white">{p.name}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="md:hidden grid grid-cols-2 gap-3">
      {featured.slice(0, 2).map((p) => (
        <a
          href={`/san-pham/${p.slug}/`}
          class="block aspect-square rounded-xl overflow-hidden ring-1 ring-[--color-border] hover:ring-[--color-accent] transition-all"
        >
          <img src={p.images[0]} alt={p.name} loading="lazy" class="w-full h-full object-cover" />
        </a>
      ))}
    </div>
  </div>
</section>
