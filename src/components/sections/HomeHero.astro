---
import CtaButton from "../ui/CtaButton.astro";
---

<section
  id="hero"
  data-hero
  class="relative w-full h-screen min-h-[100dvh] -mt-16 overflow-hidden"
>
  <video
    class="absolute inset-0 w-full h-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/videos/hero-poster.jpg"
    aria-hidden="true"
    transition:persist
  >
    <source src="/videos/hero-bg.webm" type="video/webm" />
    <source src="/videos/hero-bg.mp4" type="video/mp4" />
  </video>

  <div
    class="absolute inset-0 bg-[var(--overlay-medium)]"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-linear-to-b from-[var(--overlay-soft)] via-transparent to-[var(--overlay-strong)]"
    aria-hidden="true"
  ></div>

  <div
    class="relative z-10 flex h-full w-full flex-col items-center justify-center px-4 pt-16 pb-12 text-center text-white md:px-8"
  >
    <div data-hero-logo class="flex items-center gap-5 md:gap-7 mb-7 md:mb-9">
      <img
        src="/logos/art-color.png"
        alt="Art Color"
        class="h-12 md:h-16 w-auto drop-shadow-[0_2px_8px_rgba(0,0,0,0.45)]"
        onerror="this.style.display='none'"
      />
      <span class="h-10 md:h-12 w-px bg-white/40" aria-hidden="true"></span>
      <img
        src="/logos/technogym.png"
        alt="Technogym"
        class="h-9 md:h-12 w-auto drop-shadow-[0_2px_8px_rgba(0,0,0,0.45)]"
        onerror="this.style.display='none'"
      />
    </div>

    <p
      data-hero-meta
      class="inline-flex items-center gap-2 text-xs md:text-sm uppercase tracking-[0.3em] text-white/85 font-semibold"
    >
      <span class="inline-block w-8 h-px bg-white/60"></span>
      Phân phối Technogym chính hãng
    </p>

    <h1
      data-hero-title
      class="mt-5 text-5xl md:text-7xl lg:text-8xl font-black tracking-tight leading-[0.95] drop-shadow-[0_4px_24px_rgba(0,0,0,0.55)]"
    >
      Wellness Living
    </h1>

    <p
      data-hero-tagline
      class="mt-6 max-w-2xl text-base md:text-lg lg:text-xl text-white/85 leading-relaxed"
    >
      Thiết bị fitness cao cấp cho gia đình, phòng tập chuyên nghiệp và doanh nghiệp.
      Tư vấn lắp đặt, vận hành và bảo hành tận tâm.
    </p>

    <div
      data-hero-price
      class="mt-8 md:mt-10 flex flex-wrap justify-center gap-3"
    >
      <CtaButton href="#products">Khám phá sản phẩm</CtaButton>
      <CtaButton href="#contact" variant="outline" arrow={false}>Liên hệ tư vấn</CtaButton>
    </div>
  </div>
</section>
